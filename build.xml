<?xml version="1.0" encoding="UTF-8"?>

<project name="carbon-footprint-calculator" default="war" basedir=".">

    <!-- ========================================================= -->
    <!-- PROJECT DIRECTORIES                                      -->
    <!-- ========================================================= -->

    <property name="src.dir"       value="src/main/java"/>
    <property name="test.dir"      value="src/test/java"/>
    <property name="web.dir"       value="src/main/webapp"/>

    <property name="build.dir"     value="build"/>
    <property name="classes.dir"   value="${build.dir}/classes"/>
    <property name="test.classes"  value="${build.dir}/test-classes"/>
    <property name="reports.dir"   value="${build.dir}/test-reports"/>
    <property name="coverage.dir"  value="${build.dir}/coverage"/>
    <property name="war.dir"       value="${build.dir}/war"/>

    <property name="lib.dir"       value="lib"/>
    <property name="test.lib.dir"  value="lib/test"/>
    <property name="quality.lib.dir" value="lib/quality"/>

    <property name="war.file"
              value="${build.dir}/carbon-footprint-calculator.war"/>

    <!-- ========================================================= -->
    <!-- TOMCAT                                                    -->
    <!-- ========================================================= -->

    <property name="tomcat.home"
              value="C:/apache-tomcat-11.0.24"/>

    <!-- ========================================================= -->
    <!-- MAIN COMPILE CLASSPATH                                    -->
    <!-- ========================================================= -->

    <path id="compile.classpath">

        <fileset dir="${lib.dir}">
            <include name="*.jar"/>
        </fileset>

        <fileset dir="${tomcat.home}/lib">
            <include name="*.jar"/>
        </fileset>

    </path>

    <!-- ========================================================= -->
    <!-- TEST CLASSPATH                                            -->
    <!-- ========================================================= -->

    <path id="test.classpath">

        <pathelement location="${classes.dir}"/>

        <fileset dir="${test.lib.dir}">
            <include name="*.jar"/>
        </fileset>

        <fileset dir="${lib.dir}">
            <include name="*.jar"/>
        </fileset>

        <fileset dir="${tomcat.home}/lib">
            <include name="*.jar"/>
        </fileset>

    </path>

    <!-- ========================================================= -->
    <!-- CLEAN                                                      -->
    <!-- ========================================================= -->

    <target name="clean">

        <delete dir="${build.dir}"/>

        <mkdir dir="${build.dir}"/>

    </target>

    <!-- ========================================================= -->
    <!-- INITIALIZE DIRECTORIES                                    -->
    <!-- ========================================================= -->

    <target name="init">

        <mkdir dir="${build.dir}"/>
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${test.classes}"/>
        <mkdir dir="${reports.dir}"/>
        <mkdir dir="${coverage.dir}"/>
        <mkdir dir="${war.dir}"/>

    </target>

    <!-- ========================================================= -->
    <!-- COMPILE APPLICATION                                       -->
    <!-- ========================================================= -->

    <target name="compile" depends="init">

        <javac
            srcdir="${src.dir}"
            destdir="${classes.dir}"
            includeantruntime="false"
            source="21"
            target="21"
            encoding="UTF-8">

            <classpath refid="compile.classpath"/>

        </javac>

    </target>

    <!-- ========================================================= -->
    <!-- COMPILE JUNIT TESTS                                       -->
    <!-- ========================================================= -->

    <target name="compile-test" depends="compile">

        <javac
            srcdir="${test.dir}"
            destdir="${test.classes}"
            includeantruntime="false"
            source="21"
            target="21"
            encoding="UTF-8">

            <classpath refid="test.classpath"/>

        </javac>

    </target>

    <!-- ========================================================= -->
    <!-- RUN JUNIT TESTS + JACOCO COVERAGE                        -->
    <!-- ========================================================= -->

    <target name="test" depends="compile-test">

        <java
            classname="org.junit.platform.console.ConsoleLauncher"
            fork="true"
            failonerror="true">

            <!-- JaCoCo Java Agent -->
            <jvmarg
                value="-javaagent:${quality.lib.dir}/jacocoagent.jar=destfile=${coverage.dir}/jacoco.exec"/>

            <classpath>

                <pathelement location="${classes.dir}"/>
                <pathelement location="${test.classes}"/>

                <fileset dir="${test.lib.dir}">
                    <include name="*.jar"/>
                </fileset>

                <fileset dir="${lib.dir}">
                    <include name="*.jar"/>
                </fileset>

                <fileset dir="${tomcat.home}/lib">
                    <include name="*.jar"/>
                </fileset>

            </classpath>

            <arg value="--scan-classpath"/>

            <arg value="--reports-dir"/>
            <arg path="${reports.dir}"/>

        </java>

    </target>

    <!-- ========================================================= -->
    <!-- GENERATE JACOCO HTML COVERAGE REPORT                     -->
    <!-- ========================================================= -->

    <target name="coverage" depends="test">

        <echo message="Generating JaCoCo coverage report..."/>

        <java
            classname="org.jacoco.cli.internal.Main"
            fork="true"
            failonerror="true">

            <classpath>

                <pathelement
                    location="${quality.lib.dir}/jacococli.jar"/>

            </classpath>

            <arg value="report"/>

            <arg value="${coverage.dir}/jacoco.exec"/>

            <arg value="--classfiles"/>
            <arg path="${classes.dir}"/>

            <arg value="--sourcefiles"/>
            <arg path="${src.dir}"/>

            <arg value="--html"/>
            <arg path="${coverage.dir}/html"/>

            <arg value="--xml"/>
            <arg path="${coverage.dir}/jacoco.xml"/>

        </java>

        <echo message="JaCoCo coverage report generated successfully."/>

    </target>

    <!-- ========================================================= -->
    <!-- COPY WEB APPLICATION                                      -->
    <!-- ========================================================= -->

    <target name="copy-webapp" depends="coverage">

        <copy todir="${war.dir}">

            <fileset dir="${web.dir}"/>

        </copy>

        <!-- Create WEB-INF/lib -->

        <mkdir dir="${war.dir}/WEB-INF/lib"/>

        <!-- Copy MariaDB JDBC Driver -->

        <copy todir="${war.dir}/WEB-INF/lib">

            <fileset dir="${lib.dir}">
                <include name="*.jar"/>
            </fileset>

        </copy>

        <!-- Copy compiled application classes -->

        <copy todir="${war.dir}/WEB-INF/classes">

            <fileset dir="${classes.dir}"/>

        </copy>

    </target>

    <!-- ========================================================= -->
    <!-- BUILD WAR                                                 -->
    <!-- ========================================================= -->

    <target name="war" depends="copy-webapp">

        <war
            destfile="${war.file}">

            <fileset dir="${war.dir}"/>

        </war>

        <echo message="WAR created successfully: ${war.file}"/>

    </target>

</project>